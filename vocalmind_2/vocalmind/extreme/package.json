{
  "name": "@tll/vocalmind-extreme",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "bun run generate:routes && vite dev --port 3000",
    "generate:routes": "tsr generate",
    "build": "bun run generate:routes && vite build",
    "preview": "bun run build && vite preview",
    "wrangler:types": "wrangler types",
    "typecheck": "bun run generate:routes && tsc --noEmit",
    "lint": "biome check src scripts tests *.ts *.json",
    "lint:fix": "biome check --write src scripts tests *.ts *.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "resource:check": "bun run scripts/cloudflare-resources.ts check",
    "setup:remote": "bun run scripts/cloudflare-resources.ts setup",
    "verify:no-provider-api": "bun run scripts/verify-no-provider-api.ts",
    "verify:auth:remote": "node --experimental-strip-types scripts/verify-cloudflare-auth-e2e.ts --confirm-remote",
    "verify:legacy-passwords:remote": "node --experimental-strip-types scripts/verify-legacy-password-continuity.ts --confirm-remote",
    "smoke:local": "bun run scripts/local-smoke.ts",
    "deploy:dry": "bun run build && wrangler deploy --dry-run",
    "check": "bun run wrangler:types && bun run typecheck && bun run lint && bun run test && bun run verify:no-provider-api && bun run smoke:local && bun run build && bun run deploy:dry",
    "deploy": "bun run check && wrangler deploy"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.1",
    "@hono/zod-validator": "^0.9.0",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.1",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.22.1",
    "hono": "^4.13.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@tanstack/router-cli": "^1.167.33",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.125.0"
  }
}
