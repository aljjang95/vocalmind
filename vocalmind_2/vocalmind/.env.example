# ─────────────────────────────────────────────
# HLB 보컬스튜디오 — 환경변수 템플릿
# 이 파일을 복사해 .env.local로 저장하고 실제 값을 채우세요
# .env.local은 절대 git에 커밋하지 마세요
# ─────────────────────────────────────────────

# Anthropic (서버 전용 — NEXT_PUBLIC_ 접두사 사용 절대 금지)
ANTHROPIC_API_KEY=<ANTHROPIC_API_KEY>
# AI_MODEL=claude-sonnet-4-20250514   # 선택사항: 기본값 사용 시 주석 유지

# Supabase
NEXT_PUBLIC_SUPABASE_URL=<SUPABASE_PROJECT_URL>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<SUPABASE_ANON_KEY>
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_SERVICE_ROLE_KEY>

# Modal (AI 커버 GPU 서버리스)
MODAL_TRAINING_URL=<MODAL_TRAINING_ENDPOINT_URL>
MODAL_CONVERSION_URL=<MODAL_CONVERSION_ENDPOINT_URL>
# HQ-SVC (Zero-shot 음성 변환) — ai-cover/quick-convert 라우트
MODAL_HQSVC_URL=<MODAL_HQSVC_ENDPOINT_URL>
# Demucs (보컬/반주 분리) — /api/separate 라우트
DEMUCS_API_URL=<DEMUCS_ENDPOINT_URL>

# Runware (아바타 이미지 생성 — FLUX)
RUNWARE_API_KEY=<RUNWARE_API_KEY>

# Python FastAPI 백엔드 URL (서버 API 라우트용)
VOCAL_BACKEND_URL=http://localhost:8001
# 클라이언트 WebSocket용 (프로덕션: https://vocalmind-backend.fly.dev)
NEXT_PUBLIC_VOCAL_BACKEND_URL=http://localhost:8001
# WebSocket 전용 (useScaleWebSocket) — wss://vocalmind-backend.fly.dev
NEXT_PUBLIC_WS_BACKEND_URL=ws://localhost:8001

# 선생님 이메일 (storage-url 접근 권한)
TEACHER_EMAIL=teacher@example.com

# 토스페이먼츠 (결제)
# 서버 시크릿: TOSSPAYMENTS_SECRET_KEY 또는 TOSS_PAYMENTS_SECRET_KEY (하위 호환)
TOSSPAYMENTS_SECRET_KEY=<TOSSPAYMENTS_SECRET_KEY>
# 클라이언트 공개키 (결제 위젯용)
NEXT_PUBLIC_TOSSPAYMENTS_CLIENT_KEY=<TOSSPAYMENTS_CLIENT_KEY>
